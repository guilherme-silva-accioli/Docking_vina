# ==============================================================================
# CONFIGURAÇÃO GERAL DO DOCKING
# Altere as variáveis abaixo para o seu alvo de interesse
# ==============================================================================

# Identificadores do Alvo
TARGET="JAK2"                  # Nome da pasta/alvo (ex: AKT1, CCND1, CDK2, etc.)
PDB_ID="6WTQ"                  # Código PDB da estrutura do receptor (4 caracteres)
NATIVE_LIG="U8J"               # Código de 3 letras do ligante cristalográfico nativo
COFACTOR_RES=""                # Resíduos de cofator separados por vírgula (ex: "GNP,MG" ou "HEM"). Deixe "" se não houver.

# Diretório com arquivos de InChIKeys por receptor (.txt)
HUB_INCHIKEYS_DIR="/mnt/c/Users/gui-a/OneDrive/Desktop/TCC/Docking/hub_inchikeys"

# Dimensões da Grid Box (Angstroms)
SIZE_X="22.0"
SIZE_Y="22.0"
SIZE_Z="22.0"

# Parâmetros de Busca do AutoDock Vina
EXHAUSTIVENESS="8"             # Exaustividade de busca (padrão: 8)
NUM_MODES="9"                  # Número máximo de poses geradas
ENERGY_RANGE="3"               # Faixa máxima de energia relativa (kcal/mol)
