# ==============================================================================
# MODELO DE CONFIGURAÇÃO PARA NOVO RECEPTOR
# Copie este arquivo para configs/<NOME_DO_ALVO>.env e ajuste os valores.
# Exemplo: cp configs/template.env configs/EGFR.env
# ==============================================================================

# Identificadores do Alvo
TARGET="NOME_DO_ALVO"          # Nome da subpasta em targets/ (ex: EGFR)
PDB_ID="0000"                  # Código PDB de 4 caracteres (ex: 1M17)
NATIVE_LIG="XYZ"               # Código de 3 letras do ligante cristalográfico nativo

# Pasta com listas de InChIKeys por receptor
HUB_INCHIKEYS_DIR="/mnt/c/Users/gui-a/OneDrive/Desktop/TCC/Docking/hub_inchikeys"

# Dimensões da Caixa de Grid (Angstroms)
SIZE_X="22.0"
SIZE_Y="22.0"
SIZE_Z="22.0"

# Parâmetros de Busca do AutoDock Vina
EXHAUSTIVENESS="8"
NUM_MODES="9"
ENERGY_RANGE="3"
